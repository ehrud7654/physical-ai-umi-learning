<!--
  SO-101 pick-and-place scene / SO-101 픽앤플레이스 씬

  Includes the official SO-101 MJCF and never modifies it. When the upstream
  description is updated, replace Simulation_mujoco/ wholesale; this file stays.
  공식 SO-101 MJCF를 include만 하고 수정하지 않는다. 상류 기술서가 갱신되면
  Simulation_mujoco/ 를 통째로 교체하면 되고 이 파일은 그대로 둔다.

  NOTE: cameras are NOT declared here. MJCF `include` cannot reopen the gripper
  body to attach a wrist camera, so BOTH cameras are injected at load time from
  configs/so101.yaml by scripts/build_scene.py — one source of truth, no drift.
  주의: 카메라는 여기 없다. include된 body는 다시 열 수 없어 손목 카메라를
  XML에 선언할 수 없다. 두 카메라 모두 configs/so101.yaml 값으로 로드 시점에
  주입한다. 값이 두 군데로 갈라지지 않게 하기 위함이다.

  Compiler override must come AFTER the include: the included file declares
  meshdir="assets", which would otherwise resolve against this file's directory.
  compiler 태그는 include 뒤에 와야 한다. include된 파일이 meshdir="assets"를
  선언하는데, 그대로 두면 이 파일 기준으로 풀려서 메시를 못 찾는다.
-->
<mujoco model="so101_pick_place">
  <include file="../../../third_party/so101_mujoco/SO101/so101_new_calib.xml"/>
  <compiler angle="radian" meshdir="../../../third_party/so101_mujoco/SO101/assets" autolimits="true"/>

  <visual>
    <global offwidth="640" offheight="640" azimuth="160" elevation="-20"/>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
             rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" rgba="0.55 0.45 0.35 1"/>
    <material name="cube_mat" rgba="0.85 0.25 0.20 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" pos="0 0 -0.04" type="plane" material="groundplane"/>
    <geom name="table" type="box" size="0.30 0.30 0.02" pos="0.15 0 -0.02" material="table_mat"/>
    <body name="target_object" pos="0.22 0.00 0.011">
      <freejoint name="target_object_free"/>
      <geom name="target_object_geom" type="box" size="0.010 0.010 0.010"
            material="cube_mat" mass="0.020" friction="1.0 0.005 0.0001"/>
    </body>
  </worldbody>
</mujoco>
