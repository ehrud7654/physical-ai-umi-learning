    <child link="custom_hand_link" />
  </joint>
  <joint name="gripper" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="custom_hand_link" />
    <child link="gripper_width_link" />
    <axis xyz="0 0 1" />
    <limit effort="30" velocity=".08" lower="0" upper=".09" />
  </joint>
  <joint name="gripper_right" type="prismatic">
