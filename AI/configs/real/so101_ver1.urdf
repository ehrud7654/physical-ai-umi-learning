    <parent link="custom_hand_link" />
    <child link="pinion_link" />
    <axis xyz="0 0 1" />
    <limit effort="1" velocity="2.5" lower="-2.5" upper="0" />
    <mimic joint="gripper" multiplier="-27.7777777778" offset="0" />
