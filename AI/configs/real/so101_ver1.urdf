    </joint>
    <joint name="elbow_flex">
      <param name="id">3</param><param name="zero_tick">1024</param><param name="direction">1</param>
      <param name="min_tick">0</param><param name="max_tick">4095</param>
      <param name="min_rad">-1.57079632679</param><param name="max_rad">1.69</param>
      <command_interface name="position"/><state_interface name="position"/>
    </joint>
    <joint name="wrist_flex">
      <param name="id">4</param><param name="zero_tick">2048</param><param name="direction">1</param>
      <param name="min_tick">0</param><param name="max_tick">4095</param>
      <param name="min_rad">-1.65806</param><param name="max_rad">1.65806</param>
      <command_interface name="position"/><state_interface name="position"/>
    </joint>
    <joint name="wrist_roll">
      <param name="id">5</param><param name="zero_tick">2126</param><param name="direction">1</param>
      <param name="min_tick">0</param><param name="max_tick">4095</param>
      <param name="min_rad">-2.743847297</param><param name="max_rad">2.841206309</param>
      <command_interface name="position"/><state_interface name="position"/>
    </joint>
    <joint name="gripper">
      <param name="id">6</param><param name="closed_tick">1720</param><param name="open_tick">70</param>
      <param name="min_tick">70</param><param name="max_tick">1720</param><param name="max_width_m">0.09</param>
      <command_interface name="position"/><state_interface name="position"/>
    </joint>
  </ros2_control>
