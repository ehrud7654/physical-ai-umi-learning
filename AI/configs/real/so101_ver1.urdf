    <parent link="custom_hand_link" />
    <child link="right_finger_link" />
    <axis xyz="1 0 0" />
    <limit effort="30" velocity=".04" lower="0" upper=".045" />
    <mimic joint="gripper" multiplier="0.5" offset="0" />
  </joint>
  <joint name="gripper_mirror" type="prismatic">
