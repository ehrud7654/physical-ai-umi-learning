    <parent link="custom_hand_link" />
    <child link="gripper_tcp" />
  </joint>

  <ros2_control name="SO101System" type="system">
    <hardware>
      <plugin>so101_motor_control/SO101System</plugin>
      <param name="port">/dev/ttyTHS1</param>
      <param name="baudrate">1000000</param>
      <param name="speed">300</param>
      <param name="acceleration">10</param>
    </hardware>
    <joint name="shoulder_pan">
      <param name="id">1</param><param name="zero_tick">1990</param><param name="direction">1</param>
      <param name="min_tick">0</param><param name="max_tick">4095</param>
      <param name="min_rad">-1.91986</param><param name="max_rad">1.91986</param>
      <command_interface name="position"/><state_interface name="position"/>
    </joint>
    <joint name="shoulder_lift">
      <param name="id">2</param><param name="zero_tick">2048</param><param name="direction">1</param>
      <param name="min_tick">0</param><param name="max_tick">4095</param>
      <param name="min_rad">-1.74533</param><param name="max_rad">1.74533</param>
