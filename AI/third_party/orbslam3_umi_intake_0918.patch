+        if(!tvr){
+            Eigen::Matrix3f K = this->toK_();
+            tvr = new TwoViewReconstruction(K);
+        }
+        vP3D.clear();
+        vbTriangulated.clear();
+
+        auto tag_iter1 = std::find(markerIds1.begin(), markerIds1.end(), tag_id);
+        auto tag_iter2 = std::find(markerIds2.begin(), markerIds2.end(), tag_id);
+        if(tag_iter1 == markerIds1.end() || tag_iter2 == markerIds2.end()){
+            return false;
+        }
+        const int tag_idx1 = static_cast<int>(tag_iter1 - markerIds1.begin());
+        const int tag_idx2 = static_cast<int>(tag_iter2 - markerIds2.begin());
+
+        const cv::Mat K = this->toK();
+        const cv::Mat distortion = cv::Mat::zeros(5, 1, CV_32F);
+        const std::vector<std::vector<cv::Point2f>> corners1{markerCorners1[tag_idx1]};
+        const std::vector<std::vector<cv::Point2f>> corners2{markerCorners2[tag_idx2]};
+        std::vector<cv::Vec3d> rvecs1, tvecs1, rvecs2, tvecs2;
+        cv::aruco::estimatePoseSingleMarkers(corners1, tag_size, K, distortion, rvecs1, tvecs1);
+        cv::aruco::estimatePoseSingleMarkers(corners2, tag_size, K, distortion, rvecs2, tvecs2);
+        if(rvecs1.empty() || rvecs2.empty() ||
+           !cv::checkRange(rvecs1[0]) || !cv::checkRange(tvecs1[0]) ||
+           !cv::checkRange(rvecs2[0]) || !cv::checkRange(tvecs2[0])){
+            return false;
+        }
+
+        cv::Mat R1w, R2w;
+        cv::Rodrigues(rvecs1[0], R1w);
+        cv::Rodrigues(rvecs2[0], R2w);
+        R1w.convertTo(R1w, CV_32F);
+        R2w.convertTo(R2w, CV_32F);
+        const Sophus::SE3f T1w(Converter::toMatrix3f(R1w), Converter::toVector3f(tvecs1[0]));
+        const Sophus::SE3f T2w(Converter::toMatrix3f(R2w), Converter::toVector3f(tvecs2[0]));
+        T21 = T2w * T1w.inverse();
+        return tvr->ReconstructWithTag(vKeys1, vKeys2, vMatches12, T21, vP3D, vbTriangulated);
+    }
